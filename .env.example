# Paste this into Railway -> Variables -> "Raw Editor" and fill in the values.
# Nothing here is committed with a real secret; keep it that way.
#
# Public Supabase config. These are baked into the client bundle at BUILD time,
# so they must be present before the first deploy, not only at runtime.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-only config. Never expose these to the client.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Prefer a new server secret key when your project uses sb_secret_* API keys.
SUPABASE_SECRET_KEY=
TAKAMOL_API_KEY=

# Keep this value identical across every deploy. Changing it invalidates the
# encrypted SVP passwords inside the agent vault cookie.
SVP_CREDENTIAL_KEY=

# SMS gateway (queued messaging / exam SMS cron).
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=

# RSPay automatic wallet deposits (server only). Never prefix secrets with VITE_.
# RSPay's official merchant dashboard currently uses this API base.
RSPAY_API_BASE_URL=https://api.rspay.org/api
RSPAY_API_KEY=
RSPAY_SITE_URL=https://svp-portal.up.railway.app
RSPAY_CHECKOUT_HOSTS=pay.rspay.org
# Enable after applying 20261108140000_rspay_wallet.sql. Every checkout must
# still pass the provider callback-privacy check before the user is redirected.
RSPAY_AUTO_DEPOSIT_ENABLED=false
# This remains a deployment activation lock. Admin dashboard controls also
# require its master switch and the selected payment method to be enabled.
# Optional recovery API returning a full documented payment record (see setup doc).
RSPAY_STATUS_URL_TEMPLATE=

# Runtime: pins the Nitro target so `vite build` emits .output/server/index.mjs.
NITRO_PRESET=node-server
NODE_ENV=production

# PORT is injected by the platform (Railway/Render). Do not hardcode it.
